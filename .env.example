# Alle Einstellungen des Projekts (ESP32 und Container) an einer Stelle.
# Kopieren nach .env und ausfüllen:  cp .env.example .env
# .env steht in .gitignore und wird nicht committet.

# ---------- ESP32 ----------
# Daraus erzeugt src/esp32_firmware/load_env.py beim Build data/settings.toml,
# aufspielen mit  pio run -t uploadfs  (im Ordner src/esp32_firmware).

# WLAN vor Ort (der ESP32 kann nur 2,4 GHz)
WIFI_SSID=
WIFI_PASSWORD=

# Eindeutiger Name des Sensors, wird als MQTT-Client-ID und sensor_id verwendet
DEVICE_ID=nockenberg-pluder-esp32-01
# Gruppenname für die Topics iiot/group/<MQTT_GROUP>/sensor/temperature/state und .../status
MQTT_GROUP=nockenberg-pluder
# Sendeintervall in Sekunden (mindestens 2), zur Laufzeit per POST /config änderbar
READING_INTERVAL_SECONDS=60
# GPIO des ESP32, an dem die Datenleitung des DHT11 hängt
SENSOR_PIN=4
# Zeitserver für UTC-Zeitstempel (UDP 123, muss in der Firewall erlaubt sein)
NTP_SERVER=pool.ntp.org

# ---------- MQTT (ESP32 und Container) ----------
# Kurs-Broker (docs/iot-specs/conventions.md). Passwort in der Vorlesung erfragen.
MQTT_HOST=158.180.44.197
MQTT_PORT=1883
MQTT_USERNAME=bobm
MQTT_PASSWORD=

# ---------- Container ----------
# InfluxDB: wird beim ersten Start mit diesen Werten angelegt.
# Passwort mindestens 8 Zeichen. Token: beliebige lange Zeichenkette, z.B. aus  openssl rand -hex 32
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=
INFLUXDB_ORG=iiot
INFLUXDB_BUCKET=iiot

# Grafana-Login unter http://localhost:3000 (Benutzer admin)
GRAFANA_ADMIN_PASSWORD=
