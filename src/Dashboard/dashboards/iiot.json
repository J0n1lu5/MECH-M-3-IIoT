{
  "uid": "iiot-overview",
  "title": "IIoT Temperatur",
  "description": "Live-Daten aller Gruppen vom Kurs-Broker (iiot/group/+/...)",
  "tags": [
    "iiot"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Gruppe",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"group\", predicate: (r) => r._measurement == \"temperature\", start: -30d)",
        "definition": "Gruppen mit Messwerten",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Sensoren gesamt",
      "description": "Anzahl der Gruppen, von denen in den letzten 30 Tagen eine Messung oder ein Status ankam",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" or r._measurement == \"status\")\n  |> keep(columns: [\"group\"])\n  |> group()\n  |> distinct(column: \"group\")\n  |> count()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Sensoren online",
      "description": "Gruppen, deren letzter Status ok oder error ist (nicht offline)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"status\")\n  |> group(columns: [\"group\"])\n  |> last()\n  |> group()\n  |> filter(fn: (r) => r._value != \"offline\")\n  |> count()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0"
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
