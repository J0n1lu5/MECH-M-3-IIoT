            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"humidity_percent\" and r.group == \"nockenberg-pluder\")\n  |> group()\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "decimals": 0,
          "noValue": "noch keine Daten",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Status nockenberg-pluder",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"status\" and r.group == \"nockenberg-pluder\")\n  |> group()\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "text": "ok",
                  "color": "green",
                  "index": 0
                },
                "error": {
                  "text": "error",
                  "color": "orange",
                  "index": 1
                },
                "offline": {
                  "text": "offline",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "unbekannt",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 5,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Temperatur",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"group\"])\n  |> group(columns: [\"group\"])"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "displayName": "${__field.labels.group}",
          "custom": {
            "showPoints": "auto",
            "spanNulls": 600000
          }
        },
        "overrides": []
      },
      "id": 6,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Luftfeuchte",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"humidity_percent\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"group\"])\n  |> group(columns: [\"group\"])"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "displayName": "${__field.labels.group}",
          "custom": {
            "showPoints": "auto",
            "spanNulls": 600000
          }
        },
        "overrides": []
      },
      "id": 7,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Geräteübersicht",
      "description": "Alle Gruppen der letzten 30 Tage: letzter Status aus iiot/group/+/status und letzte Messung",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"join\"\n\nstatus = from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"status\")\n  |> group(columns: [\"group\"])\n  |> last()\n  |> group()\n  |> keep(columns: [\"group\", \"_value\", \"_time\"])\n\ntemperature = from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> group(columns: [\"group\"])\n  |> last()\n  |> group()\n  |> keep(columns: [\"group\", \"_value\", \"_time\"])\n\njoin.full(\n  left: status,\n  right: temperature,\n  on: (l, r) => l.group == r.group,\n  as: (l, r) => ({\n    \"Gruppe\": if exists l.group then l.group else r.group,\n    \"Status\": if exists l._value then l._value else \"unbekannt\",\n    \"Status seit\": l._time,\n    \"Letzte Messung\": r._time,\n    \"Temperatur\": r._value,\n  }),\n)\n  |> sort(columns: [\"Gruppe\"])"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Gruppe",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "ok",
                        "color": "green",
                        "index": 0
                      },
                      "error": {
                        "text": "error",
                        "color": "orange",
                        "index": 1
                      },
                      "offline": {
                        "text": "offline",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temperatur"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status seit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Letzte Messung"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "id": 8,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Kennzahlen im gewählten Zeitraum",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> group(columns: [\"group\"])\n  |> reduce(\n    identity: {n: 0, sum: 0.0, min: 1000.0, max: -1000.0},\n    fn: (r, accumulator) => ({\n      n: accumulator.n + 1,\n      sum: accumulator.sum + r._value,\n      min: if r._value < accumulator.min then r._value else accumulator.min,\n      max: if r._value > accumulator.max then r._value else accumulator.max,\n    }),\n  )\n  |> map(fn: (r) => ({\"Gruppe\": r.group, \"Mittelwert\": r.sum / float(v: r.n), \"Minimum\": r.min, \"Maximum\": r.max, \"Messungen\": r.n}))\n  |> group()\n  |> sort(columns: [\"Gruppe\"])"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Messungen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "id": 9,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 10
      }
    }
  ]
}